{
  "name": "farmatodo-cli",
  "version": "1.0.0",
  "description": "CLI y TUI interactiva nativa con OpenTUI Core para Farmatodo Venezuela: buscador de medicamentos y productos, precios en Bs y USD, stock en tiempo real por sucursal, tasa oficial BCV y directorio de farmacias.",
  "module": "src/index.ts",
  "type": "module",
  "bin": {
    "farmatodo": "./src/index.ts"
  },
  "private": true,
  "scripts": {
    "start": "bun run src/index.ts",
    "tui": "bun run src/index.ts tui",
    "buscar": "bun run src/index.ts buscar",
    "test": "bun test",
    "dev": "bun run --watch src/index.ts",
    "screenshot": "bun run scripts/screenshot.ts",
    "build": "bun build --compile --minify src/index.ts --outfile dist/farmatodo"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@opentui/core": "^0.5.11",
    "commander": "^15.0.0",
    "picocolors": "^1.1.1",
    "terminal-image": "^5.0.1"
  }
}
